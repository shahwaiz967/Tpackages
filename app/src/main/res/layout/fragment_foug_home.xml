<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".features.ui.fragment.FourGHomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/_10sdp"
        android:background="@color/header_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/toolBar"
        android:orientation="horizontal">

        <ImageView
            android:padding="@dimen/_5sdp"
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:textColor="@color/white"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:text="4G LTE Setting"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="@dimen/_1sdp"
        app:strokeColor="#F1F5F9"
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        android:layout_margin="@dimen/_10sdp"
        android:id="@+id/btn_LTE_Setting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:padding="@dimen/_5sdp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/_4g_circular_badge"/>

            <View
                android:layout_marginVertical="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_width="@dimen/_2sdp"
                android:layout_height="match_parent"
                android:background="#E2E8F0"/>

            <TextView
                android:layout_marginStart="@dimen/_20sdp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:textSize="@dimen/_20ssp"
                android:layout_gravity="center"
                android:text="@string/lte_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/linear1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_LTE_Setting">

        <com.codecx.tpackages.features.ui.customViews.FourGHomeTileButton
            android:id="@+id/dataUsage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            app:arrow_back_color="#D6F5E3"
            app:fourG_backColor="#EEFBF4"
            app:fourG_des="@string/check_your_mobile_data_usage"
            app:fourG_icon="@drawable/icon_data_usage"
            app:fourG_strokeColor="#D2F3E0"
            app:fourG_title="@string/data_usage"
            app:icon_background_color="#00C569" />

        <com.codecx.tpackages.features.ui.customViews.FourGHomeTileButton
            android:id="@+id/speed_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_weight="1"
            app:arrow_back_color="#FEE2E2"
            app:fourG_backColor="#FFF1F2"
            app:fourG_des="Test your Internet speed"
            app:fourG_icon="@drawable/icon_speed_test"
            app:fourG_strokeColor="#FED4D9"
            app:fourG_title="Speed Test"
            app:icon_background_color="@color/deactivate_red" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/linear2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linear1">

        <com.codecx.tpackages.features.ui.customViews.FourGHomeTileButton
            android:id="@+id/simSignalStrength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            app:arrow_back_color="#FEEBC8"
            app:fourG_backColor="#FFF9E6"
            app:fourG_des="@string/check_your_network_signal"
            app:fourG_icon="@drawable/icon_signal_strength"
            app:fourG_strokeColor="#FEF0C7"
            app:fourG_title="@string/signal_strength"
            app:icon_background_color="#F59E0B" />

        <com.codecx.tpackages.features.ui.customViews.FourGHomeTileButton
            android:id="@+id/simInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_weight="1"
            app:arrow_back_color="#EEE5FF"
            app:fourG_backColor="#F6F2FF"
            app:fourG_des="View your Sim information"
            app:fourG_icon="@drawable/icon_sim_info"
            app:fourG_strokeColor="#E9D5FF"
            app:fourG_title="Sim Info"
            app:icon_background_color="#8B5CF6" />
    </LinearLayout>

    <FrameLayout
        android:layout_margin="@dimen/_10sdp"
        android:id="@+id/ad_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>