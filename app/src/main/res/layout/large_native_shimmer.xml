<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_margin="@dimen/_5sdp"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/adBackgroundColor"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_6sdp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:background="@color/shimmer_holder_color"
                android:contentDescription="@null"
                app:layout_constraintBottom_toBottomOf="@+id/linearLayout5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/linearLayout5"
                app:shapeAppearanceOverlay="@style/RoundMediaTen" />

            <LinearLayout
                android:id="@+id/linearLayout5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_icon"
              >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/adTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:background="@drawable/native_tag"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:padding="2dp"
                        android:text="AD"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_6ssp" />

                    <TextView
                        android:id="@+id/tv_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/shimmer_holder_color"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="Loading Ad..."
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@color/shimmer_holder_color"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:scrollHorizontally="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_8ssp"
                    tools:text="Powerful Photo Editor  Video Editor  Collage Maker" />
            </LinearLayout>

            <TextView
                android:id="@+id/media_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="@dimen/_7sdp"
                android:background="@color/shimmer_holder_color"
                android:gravity="center"
                android:text="Loading Ad..."
                app:layout_constraintBottom_toTopOf="@+id/btn_cta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight="@dimen/_110sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:backgroundTint="@color/shimmer_holder_color"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</LinearLayout>
