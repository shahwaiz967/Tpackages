<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".features.ui.fragment.SimSignalStrengthFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/_10sdp"
        android:background="@color/header_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/toolBar"
        android:orientation="horizontal">

        <ImageView
            android:padding="@dimen/_5sdp"
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:textColor="@color/white"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:text="@string/signal_strength_of_sim"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_margin="@dimen/_10sdp"
                android:id="@+id/sim1Card"
                app:layout_constraintTop_toBottomOf="@+id/toolBar"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="@dimen/_1sdp"
                app:cardBackgroundColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/arrowContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:cardBackgroundColor="#DBEAFE"
                        app:strokeWidth="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_7sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="#0288D1"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/simName"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sim_1"
                        app:layout_constraintBottom_toBottomOf="@+id/arrowContainer"
                        app:layout_constraintStart_toEndOf="@+id/arrowContainer"
                        app:layout_constraintTop_toTopOf="@+id/arrowContainer" />

                    <com.codecx.tpackages.features.ui.customViews.SimSignalGaugeView
                        android:id="@+id/sim1GaugeView"
                        app:layout_constraintTop_toBottomOf="@+id/simName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:gauge_active="true"
                        android:layout_width="@dimen/_190sdp"
                        android:layout_height="@dimen/_190sdp"
                        />

                    <com.google.android.material.card.MaterialCardView
                        app:strokeColor="#E6BFDBFE"
                        app:strokeWidth="@dimen/_1sdp"
                        app:cardBackgroundColor="#B3EFF6FF"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintTop_toBottomOf="@id/sim1GaugeView"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/simSignalStrength"
                            android:layout_margin="@dimen/_10sdp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIM 1 -100 dBm "/>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_margin="@dimen/_10sdp"
                android:id="@+id/sim2Card"
                app:layout_constraintTop_toBottomOf="@+id/sim1Card"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="@dimen/_1sdp"
                app:cardBackgroundColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="@dimen/_10sdp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/Container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_10sdp"
                        app:cardBackgroundColor="#DBEAFE"
                        app:strokeWidth="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_marginVertical="@dimen/_7sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:textColor="#0288D1"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/sim2Name"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sim_2"
                        app:layout_constraintBottom_toBottomOf="@+id/Container"
                        app:layout_constraintStart_toEndOf="@+id/Container"
                        app:layout_constraintTop_toTopOf="@+id/Container" />

                    <com.codecx.tpackages.features.ui.customViews.SimSignalGaugeView
                        android:id="@+id/sim2GaugeView"
                        app:layout_constraintTop_toBottomOf="@+id/sim2Name"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:gauge_active="false"
                        android:layout_width="@dimen/_190sdp"
                        android:layout_height="@dimen/_190sdp"
                        />

                    <com.google.android.material.card.MaterialCardView
                        app:strokeColor="#E6BFDBFE"
                        app:strokeWidth="@dimen/_1sdp"
                        app:cardBackgroundColor="#B3EFF6FF"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintTop_toBottomOf="@id/sim2GaugeView"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/sim2SignalStrength"
                            android:layout_margin="@dimen/_10sdp"
                            android:layout_gravity="center"
                            android:fontFamily="@font/plus_jakarta_sans_semibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIM 2 -100 dBm "/>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>