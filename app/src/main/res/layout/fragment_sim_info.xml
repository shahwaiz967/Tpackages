                android:layout_marginHorizontal="@dimen/_15sdp"
                app:cardBackgroundColor="#F0F7FF"
                app:cardCornerRadius="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
