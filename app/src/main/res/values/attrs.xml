<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="HomeTileButton">
        <attr name="tile_title" format="string" />
        <attr name="tile_des" format="string" />
        <attr name="tile_icon" format="reference" />
        <attr name="tile_lip_color" format="color" />
        <attr name="tile_icon_background_color" format="color" />
    </declare-styleable>

    <declare-styleable name="HomeLinearTileButton" >
        <attr name="linear_tile_title" format="string" />
        <attr name="linear_tile_icon" format="reference" />
        <attr name="tile_StartColor" format="color" />
        <attr name="tile_EndColor" format="color" />
        <attr name="tile_angle" format="integer"/>
        <attr name="icon_tint" format="color"/>
    </declare-styleable>

    <declare-styleable name="HomeQuickToolButton">
        <attr name="title" format="string"/>
        <attr name="icon" format="reference"/>
        <attr name="startColor" format="color"/>
        <attr name="endColor" format="color"/>
        <attr name="strokeColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="OfferGridItem">
        <attr name="grid_label" format="string" />
        <attr name="grid_value" format="string" />
        <attr name="grid_bg_color" format="color" />
        <attr name="grid_stroke_color" format="color" />
    </declare-styleable>
</resources>